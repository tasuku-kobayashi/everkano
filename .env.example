# =============================================================================
# everkano (Project P MVP) — 環境変数テンプレート
#
# H7: シークレットは絶対にコミットしないこと。このファイルには「キー名」と
#     「ローカル開発用の公開既定値」だけを書く。
#
# 使い方（ローカル）:
#   pnpm db:start           # Supabase ローカルスタック起動
#   pnpm setup:env          # supabase status から apps/web/.env.local と apps/api/.env を生成
#   もしくは手動で:
#   cp .env.example apps/web/.env.local   # Web は NEXT_PUBLIC_* と BUNNY_* のみ参照
#   cp .env.example apps/api/.env         # API はそれ以外を参照
#
# 本番/ステージング: Vercel と FastAPI ホスト（Fly.io 等）の環境変数に設定する。
# =============================================================================

# -----------------------------------------------------------------------------
# Web（apps/web / Next.js / Vercel）
# -----------------------------------------------------------------------------
# Supabase プロジェクトURL（ローカル: http://127.0.0.1:54321）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase の anon key もしくは publishable key（`pnpm db:status` で確認）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Python API（FastAPI）のベースURL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# マジックリンクの戻り先。未設定時はブラウザの origin を使う
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 画像ストレージ（StorageAdapter）の解決方式
#   passthrough : DBのURLをそのまま使う（開発時のプレースホルダURL用）
#   bunny       : DBの値をオブジェクトキーとして Bunny.net CDN（オリジン=Backblaze B2）のURLに変換
NEXT_PUBLIC_STORAGE_DRIVER=passthrough
# Bunny.net Pull Zone のURL（例: https://everkano.b-cdn.net）。bunny 時に必須
NEXT_PUBLIC_CDN_BASE_URL=
# Bunny.net Token Authentication のセキュリティキー（サーバー専用。設定時は /media 経由で署名URLにリダイレクト）
# ※ NEXT_PUBLIC_MEDIA_SIGNED は next.config.ts がこの値の有無から自動設定する。手動で設定しないこと
BUNNY_TOKEN_AUTH_KEY=
# 署名URLの有効期限（秒）
BUNNY_TOKEN_TTL_SECONDS=3600
# 1 にすると開発サーバーでも Service Worker を登録する（本番ビルドでは常に登録）
NEXT_PUBLIC_ENABLE_SW=

# -----------------------------------------------------------------------------
# API（apps/api / FastAPI / Fly.io・RunPod・VPS 等。H5: Vercel では動かさない）
# -----------------------------------------------------------------------------
# local | staging | production（production では LLM_MODE=mock を禁止）
APP_ENV=local
LOG_LEVEL=INFO

# Postgres 直結URL（Supabase の Database 設定 > Connection string）
# ローカル: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# staging / production（ループバック以外の DB）は TLS 必須。末尾に sslmode を付けないと API は起動しない:
#   推奨: ...?sslmode=verify-full&sslrootcert=/app/certs/supabase-ca.crt（Supabase のルート証明書で検証。apps/api/README.md）
#   最低限: ...?sslmode=require（暗号化のみ。証明書は検証しない）。環境変数 PGSSLMODE でも可
# 本番で Supavisor（transaction mode, :6543）を使う場合は DATABASE_STATEMENT_CACHE_SIZE=0
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_STATEMENT_CACHE_SIZE=100
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10

# Supabase Auth の JWT 検証
#   非対称鍵（ES256/RS256）は SUPABASE_URL/auth/v1/.well-known/jwks.json から自動取得
#   旧方式（HS256）の場合のみ SUPABASE_JWT_SECRET を設定
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# トークンの iss 検証値。未設定時は {SUPABASE_URL}/auth/v1。
# Docker 内から host.docker.internal 経由で接続する場合など、SUPABASE_URL と発行者URLが異なる時に設定
SUPABASE_JWT_ISSUER=
# JWKS（公開鍵）のキャッシュ秒数
JWKS_CACHE_TTL_SECONDS=600

# CORS 許可オリジン（カンマ区切り）
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://localhost:3002

# LLM（OpenRouter 経由 DeepSeek-V3 / DeepSeek 直契約も可）
#   live : LLM_API_KEY を使って実際に生成
#   mock : 外部APIを呼ばず決定的なモック応答（ローカル開発・テスト用）
LLM_MODE=mock
# OpenRouter: https://openrouter.ai/api/v1 / DeepSeek直: https://api.deepseek.com/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# OpenRouter: deepseek/deepseek-chat / DeepSeek直: deepseek-chat
LLM_MODEL=deepseek/deepseek-chat
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=400
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# OpenRouter 用の任意ヘッダー（HTTP-Referer / X-Title）
LLM_HTTP_REFERER=
LLM_APP_TITLE=everkano
# [エンジン v1.0] 用途ごとのモデル（空 = LLM_MODEL）。返答生成（chat）は常に LLM_MODEL
#   ANALYSIS: 記憶の抽出・要約（memory_analysis / memory_summary）と好感度の評価（affinity_eval）
#   PROACTIVE: 自発メッセージの本文（proactive_message） / CAPTION: フィード投稿のキャプション（feed_caption）
LLM_MODEL_ANALYSIS=
LLM_MODEL_PROACTIVE=
LLM_MODEL_CAPTION=
# LLM_MODE=mock のストリーミングで、数文字ごとに入れる待ち（ミリ秒。0〜5000）。表示・レイテンシの確認用
LLM_MOCK_STREAM_DELAY_MS=0

# Embedding（長期メモリ用。OpenAI 互換 /embeddings API）
#   live : EMBEDDING_API_KEY を使って実際に埋め込み
#   hash : 外部APIを呼ばない文字n-gramハッシュ埋め込み（開発用。精度は低い）
EMBEDDING_MODE=hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# 埋め込み API の 1 回あたりのタイムアウト（秒）とリトライ回数（LLM_TIMEOUT_SECONDS / LLM_MAX_RETRIES とは別）。
# /chat の記憶検索は、埋め込みが間に合わなければ検索を省略して返答する（CHAT_DEADLINE_SECONDS の半分未満にすること）
EMBEDDING_TIMEOUT_SECONDS=5
EMBEDDING_MAX_RETRIES=1

# メモリエンジン（§9）
MEMORY_SHORT_TERM_TURNS=30
MEMORY_SUMMARY_TRIGGER_TURNS=50
MEMORY_IMPORTANCE_THRESHOLD=0.6
MEMORY_RETRIEVAL_TOP_K=5
MEMORY_DEDUP_SIMILARITY=0.92
# ユーザー × キャラあたりの記憶の上限件数（ユーザーの追加は上限で 422。自動抽出・要約は重要度の低い自動記憶と入れ替える）
MEMORY_MAX_PER_CHARACTER=500

# POST /chat・/chat/stream の文脈の組み立て + 応答生成の上限秒数。Web の CHAT_TIMEOUT_MS（45秒）より短くする
# （超過時は何も保存せず 503 / ストリームでは error イベント）
CHAT_DEADLINE_SECONDS=38
# POST /chat/stream でイベントが無い間に送る keep-alive コメントの間隔（秒）
CHAT_STREAM_HEARTBEAT_SECONDS=10

# -----------------------------------------------------------------------------
# キャラクターエンジン v1.0（記憶 × カレンダー × 好感度 × 自発メッセージ）
# -----------------------------------------------------------------------------
# 各仕組みの有効/無効（false で無効。評価ハーネスの「素の LLM」ベースラインに使う）。
# 無効な仕組みは返答のプロンプトに入らず、返答後のジョブ・定期実行でも処理しない
ENGINE_MEMORY_ENABLED=true
ENGINE_CALENDAR_ENABLED=true
ENGINE_AFFINITY_ENABLED=true
ENGINE_PROACTIVE_ENABLED=true

# Context Assembler（文脈の組み立て）の締め切り（秒）。間に合わない仕組みは省いて返答する（E8）
ENGINE_CONTEXT_TIMEOUT_SECONDS=1.5

# 非同期ジョブ（Postgres キュー engine_jobs）のワーカーを API プロセス内で動かすか。
# 本番（Fly.io）は API で false にし、worker プロセスグループ（python -m app.worker）で動かす
ENGINE_WORKER_ENABLED=true
# ワーカーが同時に処理するジョブの数 / 空のときの確認間隔（秒）
ENGINE_WORKER_CONCURRENCY=2
ENGINE_WORKER_POLL_INTERVAL_SECONDS=1
# 失敗したジョブの再試行（最大回数 / 指数バックオフの初回と上限の秒数）。上限に達したら dead（audit engine.job_dead）
ENGINE_JOB_MAX_ATTEMPTS=5
ENGINE_JOB_BACKOFF_BASE_SECONDS=30
ENGINE_JOB_BACKOFF_MAX_SECONDS=3600
# 1 ジョブの実行時間の上限（秒）/ 実行中のまま止まったジョブを再実行に戻すまでの秒数 / 完了したジョブを消すまでの日数
ENGINE_JOB_TIMEOUT_SECONDS=300
ENGINE_JOB_LOCK_TIMEOUT_SECONDS=600
ENGINE_JOB_RETENTION_DAYS=7
# 返答の後の非同期処理（記憶の抽出・約束の予定化・好感度の評価）を何秒後にまとめて行うか（続けて届いた発言をまとめる）/
# 1 回に処理する最大ターン数
ENGINE_POST_TURN_DELAY_SECONDS=180
ENGINE_POST_TURN_MAX_TURNS=10

# 定期実行（スケジューラ）を API プロセス内で動かすか（本番は false にして worker プロセスで動かす）。
# 複数のプロセスで有効にしても pg_try_advisory_lock で 1 つだけが実行する
ENGINE_SCHEDULER_ENABLED=true
# 期限の来たタスクを確認する間隔（秒）
ENGINE_SCHEDULER_POLL_INTERVAL_SECONDS=30
# calendar.ensure_schedules（予定の生成）の間隔（秒）と何日先まで作るか / calendar.tick（状態・予定の完了・投稿）の間隔（秒）
ENGINE_CALENDAR_ENSURE_INTERVAL_SECONDS=3600
ENGINE_CALENDAR_DAYS_AHEAD=7
ENGINE_CALENDAR_TICK_INTERVAL_SECONDS=300
# proactive.scan（自発メッセージの判定・送信）の間隔（秒）
ENGINE_PROACTIVE_SCAN_INTERVAL_SECONDS=600
# affinity.daily（気まずさ・不満の減衰など）を行う時刻（JST の時）
ENGINE_AFFINITY_DAILY_HOUR_JST=4
# 定期実行の記録（engine_schedules）とリーダーのロックの名前空間（英小文字・数字・_.:-。通常は空）。
# 評価ハーネスが共有の DB で時計を早送りするとき、本番・開発サーバーの記録と混ざらないように設定する
ENGINE_SCHEDULE_NAMESPACE=

# 自発メッセージ（E4）: 1 ユーザー 1 日あたりの上限（全キャラ合計）/ 既定の送らない時間帯（JST の時。ユーザーが変更可）
ENGINE_PROACTIVE_DAILY_LIMIT=3
ENGINE_PROACTIVE_QUIET_START=0
ENGINE_PROACTIVE_QUIET_END=7

# コスト推計（評価ハーネス）の価格表。JSON: {"<モデル名>": {"input": 円/100万トークン, "cached_input": ..., "output": ...}}
# 空なら DeepSeek V3 の既定（input ¥40 / cached_input ¥11 / output ¥165。$0.27 / $0.07 / $1.10 @ ¥150）
ENGINE_PRICE_TABLE_JSON=

# E6（自傷・希死念慮）の相談窓口と返答文面の YAML（未設定時は packages/prompts/safety/resources.ja.yaml。
# Docker イメージでは Dockerfile の ENV が /srv/everkano/safety/resources.ja.yaml を指す）。
# 公開前に窓口の番号・受付時間を必ず公式サイトで再確認すること。変更する場合だけ行頭の # を外す
# SAFETY_RESOURCES_PATH=

# ログに記録するクライアントIPの取得元ヘッダー（プロキシが上書きする信頼済みヘッダー。Fly.io: Fly-Client-IP）。
# 未設定時は接続元アドレス。X-Forwarded-For の先頭はクライアントが偽装できるため使わない
CLIENT_IP_HEADER=

# レート制限（ユーザー単位 / 1分あたり。プロセス内メモリ実装）
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_COMMENTS_PER_MINUTE=10
# POST / PATCH /memories（埋め込み API を呼ぶ）
RATE_LIMIT_MEMORIES_PER_MINUTE=30

# リクエスト本文の上限（バイト。1024〜10485760）。超えたら本文を読まずに 413（認証より前に効く）
MAX_REQUEST_BODY_BYTES=65536

# 投稿へのユーザーコメントに、投稿者キャラが自動返信する確率（0.0〜1.0）
COMMENT_AUTO_REPLY_PROBABILITY=1.0

# 監査ログにプロンプト全文を含めるか（DD用。容量に注意）
AUDIT_LOG_PROMPTS=true

# ペルソナYAML / プロンプトテンプレートの配置（未設定時はリポジトリ内 packages/ を参照。
# Docker イメージでは Dockerfile の ENV が /srv/everkano/personas・/srv/everkano/prompts を指す）
# PROMPTS_DIR は packages/prompts と packages/prompts/templates のどちらを指してもよい
# 変更する場合だけ行頭の # を外して値を入れること。空の `PERSONAS_DIR=` を env ファイルに書くと、
# docker compose / docker run --env-file でイメージの既定値が空文字で上書きされ、API が起動しない
# PERSONAS_DIR=
# PROMPTS_DIR=

# エラー監視（任意）
SENTRY_DSN=
