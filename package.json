{
  "name": "everkano",
  "private": true,
  "description": "Project P MVP — AIキャラクターSNS × DMコンパニオン (monorepo)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start --workdir infra",
    "db:stop": "supabase stop --workdir infra",
    "db:reset": "supabase db reset --workdir infra",
    "db:status": "supabase status --workdir infra",
    "db:types": "supabase gen types typescript --local --workdir infra --schema public > packages/shared/src/database.types.ts && prettier --write packages/shared/src/database.types.ts",
    "setup:env": "bash scripts/setup-env.sh",
    "db:test": "bash scripts/test-db.sh",
    "db:types:check": "bash scripts/check-db-types.sh",
    "check:secrets": "bash scripts/check-secrets.sh",
    "check:scope": "bash scripts/check-scope.sh",
    "personas:validate": "pnpm --filter @everkano/personas validate"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.4",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
