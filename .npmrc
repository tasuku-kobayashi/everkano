engine-strict=true
auto-install-peers=true
# サプライチェーン対策（ADR-0034 の補足）: 公開から 1 日（1440 分）未満の版は依存の解決で選ばない（pnpm 10.16 以降。
# packageManager は pnpm 10.33）。ロックファイルどおりに入れる `pnpm install --frozen-lockfile`（CI）には影響せず、
# `pnpm add` / `pnpm update` で新しい版を取り込むときだけ遅らせる。例外が必要なら minimum-release-age-exclude[]=<パッケージ名>
minimum-release-age=1440
