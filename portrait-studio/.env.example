# portrait-studio — copy to .env. Keys only; never commit .env (H7).
# ---- required ---------------------------------------------------------------
# Shared secret for the API (X-API-Key header / psk cookie). The API refuses to start without it.
API_KEY=
# ---- model downloads (scripts/install_models.sh) ---------------------------------
# Civitai API token (Settings → API Keys on civitai.com). Needed for gated / NSFW checkpoints. Read only by
# scripts/install_models.sh on the host (never passed into a container; the API container gets an explicit key list).
CIVITAI_TOKEN=
# Civitai model *version* id of the SDXL checkpoint to install (pick after the G2 comparison; see docs/MODELS.md)
CIVITAI_CHECKPOINT_VERSION_ID=
# Where models live on the host. MUST be on the WSL2 ext4 side (e.g. /home/<you>/models), never /mnt/c (NTFS is slow)
MODELS_DIR=./data/models
# Where generated images, references, SQLite and the audit log live (also ext4)
DATA_DIR=./data
# ---- ComfyUI image ------------------------------------------------------------------
# Official PyTorch image with the cuda12.8 tag (sm_120). Replace when a newer 2.x+cu128 tag is published.
PYTORCH_IMAGE=pytorch/pytorch:2.11.0-cuda12.8-cudnn9-devel
# Pinned to the default-branch HEAD of comfyanonymous/ComfyUI as resolved with `git ls-remote` on 2026-09-30
# (reproducible builds — `master` moving broke `--normalvram` below without warning). Bump deliberately; `master`
# also still works if you want the latest.
COMFYUI_REF=651ca296a73cd21c12a57eb8741d52e40dc6528f
# Extra ComfyUI flags, space-separated (empty = auto-detect VRAM mode). --normalvram does not exist in current
# ComfyUI (it was the auto-detected default and got removed as a flag); use --lowvram for InstantID on 12 GB.
COMFY_EXTRA_ARGS=
# Both ComfyUI and the API run unprivileged as this uid/gid inside their containers: use the owner of
# MODELS_DIR / DATA_DIR (`id -u` / `id -g`) so the bind-mounted volumes stay writable
COMFY_UID=1000
COMFY_GID=1000
# ---- API (defaults shown; docker-compose overrides the paths) -------------------------
COMFY_URL=http://127.0.0.1:8188
# DEFAULT_CHECKPOINT=  # file name under models/checkpoints; empty = first installed checkpoint
FACE_ENGINE=insightface
FACE_MODEL_ROOT=~/.insightface
FACE_MODEL_NAME=antelopev2
# ---- reference quality thresholds (composite weights are constants in api/app/face.py) ----------
QUALITY_FACE_RATIO_MIN=0.08
QUALITY_DET_SCORE_MIN=0.6
QUALITY_YAW_MAX_DEG=15
QUALITY_SHARPNESS_MIN=60
QUALITY_RECOMMEND_MIN=0.75
QUALITY_ACCEPTABLE_MIN=0.5
CLUSTER_THRESHOLD=0.5
# ---- similarity thresholds — recalibrate with scripts/face_similarity.py (docs/MODELS.md) -------
SIMILARITY_GOOD=0.75
SIMILARITY_ACCEPTABLE=0.60
# ---- generation guards --------------------------------------------------------------
MAX_CONCURRENCY=1
VRAM_SAFETY_MARGIN_MB=512
# true = allow combinations missing from api/app/data/vram_table.json (default: reject, safe side)
VRAM_ALLOW_UNMEASURED=false
LOG_LEVEL=INFO
