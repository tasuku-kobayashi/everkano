{
  "name": "portrait-studio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "portrait-studio browser UI (React + Vite + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "api:types": "openapi-typescript ../docs/api/openapi.json -o src/api/types.ts --default-non-nullable false"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "clsx": "2.1.1",
    "marked": "17.0.1",
    "openapi-fetch": "0.17.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "react-window": "1.8.11",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@types/react-window": "1.8.8",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
